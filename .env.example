# Copy to .env and adjust.

# Folder with your music (subfolders become playlists).
MUSIC_DIR=/srv/music

# Everybody who wants to listen needs this password.
SYNCMUSIC_PASSWORD=change-me

# Host port of the web app (compose.yaml).
SYNCMUSIC_PORT=8080

# Image tag: latest, a version such as 1.0.0, or edge (main branch).
SYNCMUSIC_VERSION=latest

TZ=Europe/Warsaw

# Only for compose.tailscale.yaml:
# TS_AUTHKEY=tskey-auth-...
# TS_HOSTNAME=syncmusic
